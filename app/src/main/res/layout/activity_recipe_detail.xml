<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAF7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Pantry Manager"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#205C3B"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:id="@+id/txtRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#205C3B"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients Required"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/txtRecipeIngredients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredients will appear here"
            android:textSize="16sp"
            android:textColor="#333333"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparation Instructions"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/txtRecipeInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Instructions will appear here"
            android:textSize="16sp"
            android:textColor="#333333"
            android:lineSpacingExtra="6dp"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnBackToRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Recipes"
            android:textColor="#FFFFFF"
            android:backgroundTint="#205C3B"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

</ScrollView>
