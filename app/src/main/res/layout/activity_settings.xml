<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAF7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#245C3A"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage your pantry preferences."
            android:textSize="14sp"
            android:textColor="#555555"
            android:gravity="center"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notifications"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#245C3A"
            android:layout_marginBottom="12dp"/>

        <Switch
            android:id="@+id/switchNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable expiry reminders"
            android:textColor="#222222"
            android:textSize="15sp"
            android:checked="true"
            android:layout_marginBottom="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry Alert Preferences"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#245C3A"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remind me before ingredients expire:"
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerExpiryDays"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="32dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About the App"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#245C3A"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/textAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#444444"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp"
            android:layout_marginBottom="40dp"/>

        <Button
            android:id="@+id/btnBackToPantry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Pantry"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#245C3A"/>

    </LinearLayout>

</ScrollView>
